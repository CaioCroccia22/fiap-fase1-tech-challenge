    "name": "FIAP Fase 1 - Tech Challenge",
    "description": "Collection montada a partir dos endpoints existentes no UserController da branch master do repositório. A variável userId é preenchida automaticamente após a criação de um usuário.\n\nObservações da versão atual do código:\n\n- O endpoint de alteração de senha está declarado, mas retorna null.\n    \n- O endpoint de atualização não anota o id com @PathVariable.\n    \n- Ainda não existe endpoint de validação de login.\n    \n- O cadastro atual não recebe e-mail nem senha.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "57082131"
  },
  "item": [
    {
      "name": "Usuários",
      "item": [
        {
          "name": "01 - Cadastrar usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status de criação\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id !== undefined && json.id !== null) {",
                  "        pm.collectionVariables.set(\"userId\", String(json.id));",
                  "    }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"José da Silva\",\n  \"email\": \"jose.silva.2026@email.com\",\n  \"login\": \"jose.silva.2026\",\n  \"password\": \"Senha@123\",\n  \"level\": \"OWNER\",\n  \"address\": {\n    \"address\": \"Avenida Paulista\",\n    \"number\": \"1000\",\n    \"complement\": \"3º andar, sala 300\",\n    \"zipCode\": \"01310-100\",\n    \"neighborhood\": \"Bela Vista\",\n    \"city\": \"São Paulo\",\n    \"state\": \"SP\",\n    \"country\": \"Brasil\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/user/",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "user",
                ""
              ]
            },
            "description": "Cria um usuário. Na implementação atual, o DTO recebe apenas name, login, level e address. O teste salva o id retornado em {{userId}}."
          },
          "response": []
        },
